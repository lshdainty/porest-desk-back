# Database
# MariaDB JDBC 접속 URL (jdbc:mariadb://<host>:<port>/<db>)
# 스키마명은 desk (배포 시 host 는 컨테이너명, 예: jdbc:mariadb://mariadb-prod:3306/desk)
DB_URL=jdbc:mariadb://localhost:3306/desk
# DB 접속 계정명
DB_USERNAME=your_username
# DB 접속 비밀번호 (민감정보)
DB_PASSWORD=your_password

# Redis
# Redis 서버 호스트
REDIS_HOST=localhost
# Redis 서버 포트
REDIS_PORT=6379
# Redis 접속 비밀번호 (민감정보)
REDIS_PASSWORD=your_redis_password
# 사용할 Redis DB 인덱스 — 서비스별 할당 (sso=0, hr=1, desk=2)
# 현재 desk 는 Redis 에 저장하는 데이터가 없다. 향후 캐시 용도로 쓰기 위해 번호만 예약해 둔 상태
REDIS_DATABASE=2

# Server
# 애플리케이션 HTTP 리슨 포트 (기본 8002)
SERVER_PORT=8002

# JWT
# desk 자체 access/embed 토큰 HMAC(HS256) 서명 키. 최소 256비트(32바이트) 이상. SSO 토큰은 JWKS(RS256) 검증이라 무관 (민감정보)
JWT_SECRET=your-jwt-secret-key-must-be-at-least-256-bits-long-for-hs256

# SSO
# SSO 서버 base URL. OAuth2 토큰 교환 및 JWKS 공개키 조회 기준 (sso-jwks-uri 미설정 시 이 값에서 파생)
# 서버 간 통신이므로 배포 시 컨테이너명을 쓴다 (예: http://sso-backend-prod:8000).
# 공개 도메인을 넣으면 컨테이너가 공인 IP 로 나갔다 돌아오는 NAT 헤어핀이 필요해 불안정하다
SSO_API_URL=http://localhost:8000
# SSO client_credentials 그랜트로 desk→SSO 서비스 토큰 발급용 클라이언트 시크릿. SSO admin 화면에서 클라이언트 발급 후 받은 secret 을 넣는다 (민감정보)
SSO_CLIENT_SECRET=<발급받은-secret>

# 토스 per-user 크리덴셜 등 민감값 AES-256-GCM 암호화 키. Base64 32바이트 (예: openssl rand -base64 32) (민감정보)
APP_ENCRYPTION_KEY=

# Toss Securities Open API (조회 프록시 연동). 인증은 서버 공용 키가 아니라 사용자가 등록한
# 본인 키(암호화 저장)로 대리 조회하므로 client_id/secret 는 .env 에 두지 않는다. base-url·타임아웃만 설정.
# 토스 Open API base URL (미설정 시 기본값 https://openapi.tossinvest.com)
TOSS_API_URL=https://openapi.tossinvest.com
# 토스 API 연결(connect) 타임아웃 (ms, 기본 5000)
TOSS_CONNECT_TIMEOUT=5000
# 토스 API 읽기(read) 타임아웃 (ms, 기본 10000)
TOSS_READ_TIMEOUT=10000

# 대한민국 공휴일 자동 동기화
# 1차 소스: 한국천문연구원 특일정보 API (공공데이터포털)
#   https://www.data.go.kr/data/15012690/openapi.do 에서 활용신청 후 발급(자동승인)
#   반드시 "디코딩" 인증키를 넣는다. 인코딩 키(%2B·%3D 포함)를 넣어도 동작하도록 방어해 두었지만
#   포털이 표기하는 디코딩 키가 기본값이다. 미설정 시 KASI 를 건너뛰고 폴백 소스만 사용한다.
KASI_SERVICE_KEY=
KASI_API_URL=https://apis.data.go.kr/B090041/openapi/service/SpcdeInfoService
KASI_CONNECT_TIMEOUT=5000
KASI_READ_TIMEOUT=10000
# 폴백 소스: 우주항공청 월력요항 기반 정적 JSON (holidays-kr, MIT)
HOLIDAY_FALLBACK_ENABLED=true
HOLIDAY_FALLBACK_URL=https://holidays.hyunbin.page
HOLIDAY_FALLBACK_CONNECT_TIMEOUT=5000
HOLIDAY_FALLBACK_READ_TIMEOUT=10000
# 정기 동기화 (기본 매일 12:00, 당해 + 익년 = 하루 2콜. 개발계정 일 10,000건 한도에 여유가 크다)
HOLIDAY_SYNC_ENABLED=true
HOLIDAY_SYNC_CRON=0 0 12 * * *
HOLIDAY_SYNC_LOOKAHEAD_YEARS=1
# 과거 연도 백필. 기동 시 1회 실행되며, 적재가 끝나면 false 로 되돌린다.
HOLIDAY_BACKFILL_ENABLED=false
HOLIDAY_BACKFILL_START_YEAR=2004

# 한국투자증권 종목 마스터파일 동기화 (주식 종목 검색용)
# 인증 없는 공개 다운로드라 API 키가 필요 없다. 전부 기본값으로 동작하므로 보통 설정할 게 없다.
# 국내 KOSPI/KOSDAQ/KONEX/업종지수 + 해외 미국/중국/일본/홍콩/베트남 11개 시장, 약 33,000건
KIS_MASTER_BASE_URL=https://new.real.download.dws.co.kr/common/master
KIS_MASTER_CONNECT_TIMEOUT=5000
KIS_MASTER_READ_TIMEOUT=30000
# 정기 동기화 (기본 매일 07:00 — 미국장 마감 후, 국내장 개장 전)
KIS_MASTER_SYNC_ENABLED=true
KIS_MASTER_SYNC_CRON=0 0 7 * * *
# 기동 시 테이블이 비어 있으면 1회 적재. 데이터가 있으면 아무것도 하지 않는다(count 1회).
KIS_MASTER_BACKFILL_ENABLED=true

# CORS
# CORS 허용 오리진 목록 (여러 개는 콤마로 구분)
# 브라우저 Origin 과 대조하므로 배포 시 공개 도메인을 쓴다
#   운영 예: https://desk.porest.cloud   개발 예: https://desk-dev.porest.cloud:10443 (포트 필수)
CORS_ORIGINS=http://localhost:3002

# desk 자체 access token 만료 (ms, 기본 3600000 = 1시간)
JWT_ACCESS_EXPIRATION=3600000

# Logging (info / debug / trace / warn / error)
# 앱 패키지(com.porest.desk) 로그 레벨
LOG_LEVEL=info
# Hibernate SQL 로그 레벨
LOG_LEVEL_HIBERNATE=info
# Hibernate SQL 파라미터 바인딩 값 로그 레벨 (상세 추적 시 trace)
LOG_LEVEL_HIBERNATE_BINDER=info
# 루트 로거 레벨
LOG_LEVEL_ROOT=info

# P6Spy (true / false)
# P6Spy SQL 실행 로깅 사용 여부
P6SPY_ENABLED=true

# Swagger (true / false)
# Swagger UI / api-docs 노출 여부 (운영에선 false 권장)
SWAGGER_ENABLED=true

# Error Display — 에러 응답에 포함할 상세 정보. 운영에선 내부정보 노출 방지를 위해 끄는(never/false) 게 표준
# 에러 응답에 스택트레이스 포함 (never | always | on-param)
ERROR_STACKTRACE=never
# 에러 응답에 예외 메시지 포함 (never | always | on-param)
ERROR_MESSAGE=never
# 에러 응답에 예외 클래스명 포함 (true | false — 이 키만 boolean)
ERROR_EXCEPTION=false
# 에러 응답에 바인딩(검증) 오류 상세 포함 (never | always | on-param)
ERROR_BINDING=never
