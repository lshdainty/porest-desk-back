# Database
DB_URL=jdbc:mariadb://localhost:3306/porest_desk
DB_USERNAME=your_username
DB_PASSWORD=your_password

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=your_redis_password
REDIS_DATABASE=3

# Server
SERVER_PORT=8002

# JWT
JWT_SECRET=your-jwt-secret-key-must-be-at-least-256-bits-long-for-hs256
JWT_SSO_SECRET=your-sso-secret-key-must-be-at-least-256-bits-long-for-hs256

# SSO
SSO_API_URL=http://localhost:8000

# 민감값 암호화 키 (토스 per-user 크리덴셜 AES-256-GCM). Base64 32바이트 (예: openssl rand -base64 32)
APP_ENCRYPTION_KEY=

# Toss Securities Open API (조회 프록시 연동). 인증은 서버 공용 키가 아니라 사용자가 등록한
# 본인 키(암호화 저장)로 대리 조회하므로 client_id/secret 는 .env 에 두지 않는다. base-url·타임아웃만 설정.
# (base-url 기본값 있음 — 미설정 시 https://openapi.tossinvest.com)
TOSS_API_URL=https://openapi.tossinvest.com
TOSS_CONNECT_TIMEOUT=5000
TOSS_READ_TIMEOUT=10000

# CORS
CORS_ORIGINS=http://localhost:3002

# Logging (info / debug / trace / warn / error)
LOG_LEVEL=info
LOG_LEVEL_HIBERNATE=info
LOG_LEVEL_ROOT=info

# P6Spy (true / false)
P6SPY_ENABLED=true

# Swagger (true / false)
SWAGGER_ENABLED=true

# Error Display (always / never)
ERROR_STACKTRACE=never
ERROR_MESSAGE=never
ERROR_EXCEPTION=false
ERROR_BINDING=never
